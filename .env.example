# Runtime
AEGIS_ENV=development
AEGIS_LOG_LEVEL=INFO
AEGIS_CONFIG_DIR=./config
AEGIS_ARTIFACT_ROOT=./artifacts
AEGIS_TENANT_MODE=single

# Persistence
DATABASE_URL=postgresql+asyncpg://aegis:change-me@postgres:5432/aegis
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=redis://redis:6379/0
REDIS_DOCUMENT_QUEUE=aegis:documents
REDIS_REVIEW_QUEUE=aegis:reviews

# Object storage
STORAGE_ENDPOINT=http://object-storage:9000
STORAGE_BUCKET=aegis-contracts
STORAGE_ACCESS_KEY=aegis
STORAGE_SECRET_KEY=change-me
STORAGE_REGION=us-east-1
STORAGE_SECURE=false

# Model gateway
MODEL_PROVIDER=openai-compatible
MODEL_API_BASE=https://api.example.com/v1
MODEL_API_KEY=
MODEL_CHAT_NAME=your-chat-model
MODEL_EMBEDDING_NAME=your-embedding-model
MODEL_RERANK_NAME=your-rerank-model
MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
MODEL_REVIEW_TOKEN_BUDGET=120000

# Document processing
DOCUMENT_OCR_ENABLED=true
DOCUMENT_MAX_FILE_MB=50
DOCUMENT_MAX_PAGES=500
DOCUMENT_PARSE_TIMEOUT_SECONDS=900

# Review
REVIEW_DEFAULT_POLICY=enterprise-general-v1
REVIEW_MIN_CONFIDENCE=0.72
REVIEW_REQUIRE_SOURCE_ANCHOR=true
REVIEW_MAX_CONCURRENCY=4
REVIEW_TIMEOUT_SECONDS=900

# Observability
OBSERVABILITY_TRACING_ENABLED=true
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_REDACT_CONTRACT_TEXT=true
OBSERVABILITY_RETENTION_DAYS=14

